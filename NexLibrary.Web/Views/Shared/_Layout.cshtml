<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NexLibrary</title>

    <style>
            body {
                margin: 0;
                font-family: "Segoe UI", Arial, sans-serif;
                background: #f5f7fa;
                color: #222;
            }

            .layout {
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 230px;
                background: #232d3c;
                color: white;
                padding: 20px 15px;
            }

            .brand {
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 30px;
            }

            .menu-link {
                display: block;
                color: white;
                text-decoration: none;
                background: #34495e;
                padding: 13px 15px;
                border-radius: 8px;
                margin-bottom: 10px;
                font-weight: 600;
            }

            .menu-link:hover {
                background: #405c78;
            }

            .content {
                flex: 1;
                padding: 25px;
            }

            .topbar {
                background: white;
                border-radius: 12px;
                padding: 18px 22px;
                margin-bottom: 20px;
                box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            }

            .topbar-title {
                font-size: 24px;
                font-weight: 700;
            }
    </style>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand">NexLibrary</div>

            <a class="menu-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="menu-link" asp-controller="Books" asp-action="Index">Kitaplar</a>
            <a class="menu-link" asp-controller="Members" asp-action="Index">Üyeler</a>
            <a class="menu-link" asp-controller="Loans" asp-action="Index">Ödünç İşlemleri</a>
            <a class="menu-link" asp-controller="BookCopies" asp-action="Index">Kitap Kopyaları</a>
            <a class="menu-link" asp-controller="FormFields" asp-action="Index">Form Alanları</a>
            <a class="menu-link" asp-controller="Reports" asp-action="Index">Raporlar</a>
            <a class="menu-link" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>
</body>
</html>