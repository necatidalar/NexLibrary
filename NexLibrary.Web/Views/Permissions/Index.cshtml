@model NexLibrary.Web.ViewModels.Permissions.PermissionsIndexViewModel
@using NexLibrary.Contracts.Permissions

@{
    ViewData["Title"] = "Yetki Yönetimi";
}

<style>
    .page-header,
    .role-card,
    .permission-card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        border: 1px solid #eef0f3;
        margin-bottom: 20px;
    }

    .page-header {
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        margin-top: 4px;
        font-size: 14px;
    }

    .btn {
        border: none;
        background: #34495e;
        color: white;
        padding: 10px 15px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
        white-space: nowrap;
    }

        .btn:hover {
            background: #405c78;
        }

    .btn-light {
        background: #e5e7eb;
        color: #111827;
    }

        .btn-light:hover {
            background: #d1d5db;
        }

    .btn-green {
        background: #166534;
    }

        .btn-green:hover {
            background: #14532d;
        }

    .role-card {
        padding: 16px;
    }

    .role-form {
        display: flex;
        gap: 10px;
        align-items: end;
        flex-wrap: wrap;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
        }

    .select {
        padding: 11px 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        min-width: 260px;
    }

    .alert {
        padding: 14px 16px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-size: 14px;
        font-weight: 700;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .selected-role-box {
        background: #f9fafb;
        border: 1px solid #eef0f3;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 20px;
    }

    .selected-role-title {
        font-size: 17px;
        font-weight: 800;
        color: #111827;
    }

    .selected-role-desc {
        color: #6b7280;
        font-size: 13px;
        margin-top: 4px;
    }

    .permission-card {
        overflow: hidden;
    }

    .permission-header {
        padding: 16px 18px;
        border-bottom: 1px solid #eef0f3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f9fafb;
    }

    .permission-title {
        font-size: 18px;
        font-weight: 800;
        color: #111827;
    }

    .permission-count {
        font-size: 13px;
        color: #6b7280;
        font-weight: 700;
    }

    .permission-body {
        padding: 14px 18px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 12px;
    }

    .permission-item {
        border: 1px solid #eef0f3;
        border-radius: 12px;
        padding: 12px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        background: white;
    }

        .permission-item:hover {
            background: #f9fafb;
        }

    .permission-check {
        margin-top: 4px;
    }

    .permission-name {
        font-weight: 800;
        color: #111827;
        margin-bottom: 3px;
    }

    .permission-code {
        font-size: 12px;
        color: #2563eb;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .permission-desc {
        font-size: 12px;
        color: #6b7280;
    }

    .badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        background: #dbeafe;
        color: #1d4ed8;
        margin-top: 5px;
    }

    .actions-bar {
        position: sticky;
        bottom: 0;
        background: white;
        border-top: 1px solid #eef0f3;
        padding: 14px 18px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.04);
        margin: 20px -18px -18px -18px;
    }

    .quick-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    @@media (max-width: 700px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .role-form {
            flex-direction: column;
            align-items: stretch;
        }

        .select {
            min-width: 100%;
        }

        .actions-bar {
            position: static;
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="page-header">
    <div>
        <div class="page-title">Yetki Yönetimi</div>
        <div class="page-subtitle">
            Roller için menü, ekran ve işlem yetkilerini yönetin.
        </div>
    </div>

    <a class="btn btn-light" asp-controller="Dashboard" asp-action="Index">
        Dashboard'a Dön
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-error">@TempData["ErrorMessage"]</div>
}

<div class="role-card">
    <form class="role-form" method="get" asp-controller="Permissions" asp-action="Index">
        <div class="form-group">
            <label>Rol Seç</label>
            <select class="select" name="rolId">
                @foreach (var role in Model.Roles)
                {
                    if (role.RolId == Model.SelectedRoleId)
                    {
                        <option value="@role.RolId" selected>@role.RolAdi (@role.RolKodu)</option>
                    }
                    else
                    {
                        <option value="@role.RolId">@role.RolAdi (@role.RolKodu)</option>
                    }
                }
            </select>
        </div>

        <button class="btn" type="submit">Rolü Göster</button>
    </form>
</div>

@if (Model.SelectedRoleId > 0)
{
    <form method="post" asp-controller="Permissions" asp-action="Update">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="SelectedRoleId" />

        <div class="selected-role-box">
            <div class="selected-role-title">
                @Model.SelectedRoleName
            </div>

            <div class="selected-role-desc">
                Rol Kodu: @Model.SelectedRoleCode — Seçilen yetkiler giriş yapan kullanıcıya tekrar login sonrası yansır.
            </div>
        </div>

        <div class="quick-actions">
            <button class="btn btn-light" type="button" onclick="selectAllPermissions()">Tümünü Seç</button>
            <button class="btn btn-light" type="button" onclick="clearAllPermissions()">Tümünü Kaldır</button>
            <button class="btn btn-light" type="button" onclick="selectViewPermissions()">Sadece Görüntüleme Yetkilerini Seç</button>
        </div>

        @if (Model.Groups.Count == 0)
        {
            <div class="permission-card">
                <div class="permission-header">
                    <div class="permission-title">Yetki bulunamadı</div>
                </div>
            </div>
        }
        else
        {
            foreach (var group in Model.Groups)
            {
                <div class="permission-card">
                    <div class="permission-header">
                        <div class="permission-title">@GetModuleTitle(group.ModulKodu)</div>
                        <div class="permission-count">@group.Items.Count yetki</div>
                    </div>

                    <div class="permission-body">
                        @foreach (var item in group.Items)
                        {
                            var checkedText = item.SeciliMi ? "checked" : "";

                            <label class="permission-item">
                                <input class="permission-check"
                                       type="checkbox"
                                       name="SelectedPermissionIds"
                                       value="@item.YetkiTanimiId"
                                       data-code="@item.YetkiKodu"
                                @checkedText />

                                <span>
                                    <span class="permission-name">@item.YetkiAdi</span>
                                    <span class="permission-code">@item.YetkiKodu</span>

                                    @if (!string.IsNullOrWhiteSpace(item.Aciklama))
                                    {
                                        <span class="permission-desc">@item.Aciklama</span>
                                    }

                                    @if (item.MenuYetkisiMi)
                                    {
                                        <span class="badge">Menü Yetkisi</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </div>
            }
        }

        <div class="actions-bar">
            <a class="btn btn-light"
                   asp-controller="Permissions"
                   asp-action="Index"
                   asp-route-rolId="@Model.SelectedRoleId">
                Değişiklikleri Geri Al
            </a>

            <button class="btn btn-green" type="submit">
                Yetkileri Kaydet
            </button>
        </div>
    </form>
}

<script>
    function selectAllPermissions() {
        document.querySelectorAll("input[name='SelectedPermissionIds']")
            .forEach(function (item) {
                item.checked = true;
            });
    }

    function clearAllPermissions() {
        document.querySelectorAll("input[name='SelectedPermissionIds']")
            .forEach(function (item) {
                item.checked = false;
            });
    }

    function selectViewPermissions() {
        document.querySelectorAll("input[name='SelectedPermissionIds']")
            .forEach(function (item) {
                const code = item.getAttribute("data-code") || "";
                item.checked = code.endsWith(".View");
            });
    }
</script>

@functions {
    private static string GetModuleTitle(string moduleCode)
    {
        return moduleCode switch
        {
            "Dashboard" => "Dashboard",
            "Books" => "Kitaplar",
            "Members" => "Üyeler",
            "Loans" => "Ödünç İşlemleri",
            "BookCopies" => "Kitap Kopyaları",
            "Reports" => "Raporlar",
            "FormFields" => "Form Alanları",
            "Users" => "Kullanıcılar",
            "Permissions" => "Yetki Yönetimi",
            _ => moduleCode
        };
    }
}