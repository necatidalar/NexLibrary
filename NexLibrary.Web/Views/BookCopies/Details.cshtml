@model NexLibrary.Web.ViewModels.BookCopies.BookCopyDetailViewModel

@{
    ViewData["Title"] = "Kitap Kopya Detay";
    var copy = Model.Copy;
}

<style>
    .page-header, .card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        border: 1px solid #eef0f3;
        margin-bottom: 20px;
    }

    .page-header {
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        margin-top: 4px;
        font-size: 14px;
    }

    .btn {
        border: none;
        background: #34495e;
        color: white;
        padding: 10px 15px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
    }

    .btn-light {
        background: #e5e7eb;
        color: #111827;
    }

    .card-header {
        padding: 16px 18px;
        border-bottom: 1px solid #eef0f3;
        font-size: 18px;
        font-weight: 700;
    }

    .card-body {
        padding: 18px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(220px, 1fr));
        gap: 14px;
    }

    .info-item {
        background: #f9fafb;
        border: 1px solid #eef0f3;
        border-radius: 10px;
        padding: 12px;
    }

    .label {
        color: #6b7280;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .value {
        font-size: 15px;
        font-weight: 600;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

    th, td {
        padding: 12px;
        border-bottom: 1px solid #eef0f3;
        text-align: left;
        white-space: nowrap;
    }

    th {
        background: #f9fafb;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: #edf2f7;
    }
</style>

<div class="page-header">
    <div>
        <div class="page-title">Kitap Kopya Detay</div>
        <div class="page-subtitle">@copy.KitapAdi - @copy.Barkod</div>
    </div>

    <a class="btn btn-light"
           asp-controller="BookCopies"
           asp-action="Index"
           asp-route-kitapId="@copy.KitapId">
        Kopyalara Dön
    </a>
</div>

<div class="card">
    <div class="card-header">Kopya Bilgileri</div>

    <div class="card-body">
        <div class="info-grid">
            <div class="info-item">
                <div class="label">Kopya ID</div>
                <div class="value">@copy.Id</div>
            </div>

            <div class="info-item">
                <div class="label">Kitap</div>
                <div class="value">@copy.KitapAdi</div>
            </div>

            <div class="info-item">
                <div class="label">Barkod</div>
                <div class="value">@copy.Barkod</div>
            </div>

            <div class="info-item">
                <div class="label">Demirbaş No</div>
                <div class="value">@(copy.DemirbasNo ?? "-")</div>
            </div>

            <div class="info-item">
                <div class="label">Durum</div>
                <div class="value"><span class="badge">@copy.Durum</span></div>
            </div>

            <div class="info-item">
                <div class="label">Aktif Mi?</div>
                <div class="value">@(copy.AktifMi ? "Evet" : "Hayır")</div>
            </div>

            <div class="info-item">
                <div class="label">Açıklama</div>
                <div class="value">@(copy.Aciklama ?? "-")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Aynı Kitabın Diğer Kopyaları</div>

    <div class="card-body">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Kopya ID</th>
                        <th>Barkod</th>
                        <th>Demirbaş No</th>
                        <th>Durum</th>
                        <th>Aktif</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.OtherCopies.Count == 0)
                    {
                        <tr>
                            <td colspan="6">Başka kopya bulunamadı.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var other in Model.OtherCopies)
                        {
                            <tr>
                                <td>@other.Id</td>
                                <td>@other.Barkod</td>
                                <td>@(other.DemirbasNo ?? "-")</td>
                                <td>@other.Durum</td>
                                <td>@(other.AktifMi ? "Evet" : "Hayır")</td>
                                <td>
                                    <a class="btn btn-light"
                                           asp-controller="BookCopies"
                                           asp-action="Details"
                                           asp-route-kitapId="@other.KitapId"
                                           asp-route-copyId="@other.Id">
                                        Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>